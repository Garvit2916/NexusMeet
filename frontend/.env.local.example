# Local development: the browser calls the FastAPI service directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional same-origin proxy. When API_ORIGIN is set, Next.js forwards /api/*
# to that origin, so the session cookie stays first-party. Use the API origin
# only, without the /api/v1 path.
#
# On Vercel set:
#   API_ORIGIN=https://<your-api-service>.onrender.com
#   NEXT_PUBLIC_API_URL=/api/v1
# API_ORIGIN=https://nexusmeet-api.onrender.com

# --- Real-time media ---------------------------------------------------------
# The WebSocket address is NOT configured here. The browser asks the
# authenticated API for a short-lived signaling ticket, and the response carries
# the absolute wss:// URL plus the STUN/TURN servers. That keeps the TURN
# credential off this bundle and lets the socket bypass the REST proxy.
#
# NEXT_PUBLIC_STUN_URL is only a fallback for local development when the API
# cannot be reached. Leave it unset in production so the ticket is authoritative.
# NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
