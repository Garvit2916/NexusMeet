APP_NAME=NexusMeet API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/nexusmeet.db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_USER_ID=usr_default_000000000000000000000001
DEFAULT_USER_NAME=Demo User
DEFAULT_USER_EMAIL=demo@nexusmeet.local
DEFAULT_USER_AVATAR_URL=
SEED_SAMPLE_DATA=true
CURRENT_USER_HEADER=X-User-ID
REQUEST_ID_HEADER=X-Request-ID
