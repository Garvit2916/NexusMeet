APP_NAME=NexusMeet API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/nexusmeet.db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_USER_ID=usr_default_000000000000000000000001
DEFAULT_USER_NAME=Demo User
DEFAULT_USER_EMAIL=demo@nexusmeet.app
DEFAULT_USER_AVATAR_URL=
DEFAULT_USER_PASSWORD=demo12345
SEED_SAMPLE_DATA=true
SESSION_COOKIE_NAME=nexusmeet_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SAMESITE=lax
# Leave empty to enable secure cookies automatically when ENVIRONMENT=production
SESSION_COOKIE_SECURE=
REQUEST_ID_HEADER=X-Request-ID

# --- Real-time media (WebRTC signaling) -------------------------------------
# Signs the short-lived ticket a browser presents on the WebSocket handshake.
# Generate a real value for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the /ws-ticket endpoint returns 503 SIGNALING_NOT_CONFIGURED
# while this is still the development default, so media cannot run on a key that
# is published in this file.
WS_TICKET_SECRET=
WS_TICKET_TTL_SECONDS=120
# Full-mesh room capacity guard. Each extra participant adds one peer connection
# to every browser in the room, so keep this modest.
MAX_WEBRTC_PARTICIPANTS=6
# Absolute ws:// or wss:// origin browsers use for the signaling socket. Must be
# this service's own public origin, because a frontend REST proxy cannot carry
# a WebSocket upgrade. Leave empty in local development to derive it from the
# request host.
PUBLIC_WS_URL=
# Comma-separated STUN servers. These are public and carry no credentials.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN is what makes media connect through symmetric NAT and strict firewalls.
# Leave TURN_URL empty to run STUN-only, but connectivity is then not guaranteed
# for every network. All three values are required for TURN to be advertised.
# These credentials stay on the server and reach the browser only inside the
# authenticated ticket response, never in the frontend bundle.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
